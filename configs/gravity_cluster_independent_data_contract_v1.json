  "role_requirements": {
    "calibration_roles": [
      "background_provenance",
      "detector_or_instrument_calibration",
      "point_spread_or_beam_response",
      "selection_or_mask_provenance",
      "spectral_or_bandpass_response"
    ],
    "covariance_roles": [
      "calibration_covariance",
      "measurement_uncertainty_or_covariance"
    ],
    "missing_role_action": "FAIL_PACKET_BEFORE_TARGET_ACCESS"
  },
  "unit_and_constant_freeze": {
    "internal_units": {
      "radius": "kpc",
      "mass": "solar_mass",
      "acceleration": "m_s-2",
      "electron_number_density": "cm-3",
      "electron_pressure": "keV_cm-3",
      "spectroscopic_temperature": "keV",
      "angle": "radian"
    },
    "constants": {
      "kiloparsec_m": 3.0856775814913673e19,
      "megaparsec_m": 3.0856775814913673e22,
      "solar_mass_kg": 1.98847e30,
      "electronvolt_joule": 1.602176634e-19,
      "gravitational_constant_m3_kg-1_s-2": 6.6743e-11,
      "proton_mass_kg": 1.67262192369e-27
    },
    "source_native_scaled_profile_rule": "Store the released dimensionless value, released scale, released physical value, and source cosmology separately; never silently substitute a new R500, P500, or T500.",
    "uncertainty_rule": "Every deterministic unit conversion applies to samples or the complete covariance, not only to central values."
  },
  "cosmology_and_redshift_freeze": {
    "reference_cosmology": {
      "model": "flat_LCDM",
      "H0_km_s-1_Mpc-1": 70.0,
      "Omega_m": 0.3,
      "Omega_lambda": 0.7
    },
    "angular_to_physical_rule": "r_kpc=theta_radian*D_A_kpc(z) using the frozen reference cosmology; compare against source-native radii and carry the difference as a cosmology sensitivity.",
    "allowed_redshift_uses": [
      "object_identity_and_duplicate_resolution",
      "rest_frame_spectral_response_or_k_correction",
      "angular_diameter_distance_under_the_frozen_cosmology",
      "declared_E_z_scaling_sensitivity",
      "predictor_blind_stratification_frozen_before_target_access"
    ],
    "prohibited_redshift_uses": [
      "candidate_formula_input",
      "object_specific_gravity_coefficient",
      "unregistered_distance_proxy",
      "response_informed_selection_or_exclusion",
      "substitute_for_a_direct_thermodynamic_observable"
    ]
  },
  "transformations": [
    {
      "transformation_id": "ANGULAR_RADIUS_TO_KPC",
      "inputs": ["angle_radian", "spectroscopic_redshift"],
      "outputs": ["radius_kpc"],
      "required_uncertainty": "angle_redshift_and_cosmology_sensitivity",
      "forbidden_outputs": ["halo_radius", "total_mass_profile"]
    },
    {
      "transformation_id": "XRAY_SPECTRUM_TO_PROJECTED_TEMPERATURE",
      "inputs": ["calibrated_xray_spectrum", "background", "spectral_response"],
      "outputs": ["spectroscopic_temperature_keV"],
      "required_uncertainty": "posterior_or_likelihood_with_cross_calibration_nuisance",
      "forbidden_outputs": ["hydrostatic_mass", "latent_nonthermal_pressure"]
    },
    {
      "transformation_id": "XRAY_SURFACE_BRIGHTNESS_TO_ELECTRON_DENSITY",
      "inputs": ["calibrated_xray_surface_brightness", "background", "psf", "spectral_emissivity"],
      "outputs": ["electron_density_cm-3"],
      "required_uncertainty": "deprojection_geometry_emissivity_background_and_calibration_covariance",
      "forbidden_outputs": ["hydrostatic_mass", "dark_matter_fraction"]
    },
    {
      "transformation_id": "SZ_MAP_TO_ELECTRON_PRESSURE",
      "inputs": ["calibrated_multiband_sz_map", "beam", "bandpass", "mask", "transfer_function"],
      "outputs": ["electron_pressure_keV_cm-3"],
      "required_uncertainty": "map_noise_beam_bandpass_foreground_and_deprojection_covariance",
      "forbidden_outputs": ["hydrostatic_mass", "halo_pressure_truth"]
    },
    {
      "transformation_id": "MEMBER_LIGHT_TO_STELLAR_BARYON_PROFILE",
      "inputs": ["calibrated_member_photometry_or_spectra", "membership_selection", "psf", "mask"],
      "outputs": ["stellar_baryon_profile_solar_mass"],
      "required_uncertainty": "membership_photometry_k_correction_IMF_mass_to_light_and_ICL_nuisances",
      "forbidden_outputs": ["abundance_matched_mass", "halo_mass"]
    }
  ],
  "leakage_and_exclusion_freeze": {
    "forbidden_predictor_or_selection_fields": [
      "abundance_matched_mass",
      "cluster_halo_mass",
      "cluster_halo_profile",
