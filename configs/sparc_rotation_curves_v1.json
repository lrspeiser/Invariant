  "mass_to_light_convention": {
    "status": "declared universal constants, identical for every galaxy; never fitted, never per-object",
    "disk_3_6um": "1/2",
    "bulge_3_6um": "7/10",
    "unit": "M_Sun/L_Sun at 3.6 micron",
    "citation": "McGaugh S. S., Schombert J. M., 2014, AJ 148, 77 (stellar population synthesis mass-to-light ratios at 3.6 micron); adopted as the fiducial SPARC values Upsilon_disk = 0.5 and Upsilon_bulge = 0.7 by Lelli, McGaugh & Schombert 2016 (AJ 152, 157) and by McGaugh, Lelli & Schombert 2016 (Phys. Rev. Lett. 117, 201101)",
    "application": "V_bar^2(r) = Vgas*|Vgas| + Upsilon_disk*Vdisk^2 + Upsilon_bulge*Vbul^2, with the published columns given at M/L = 1 so the ratios enter as plain multipliers; the signed gas term preserves the published sign convention for central HI holes"
  },
  "selection": {
    "rule": "a declared set of six long-studied galaxies chosen before any fit was run, to span the widest available baryonic mass range in the catalogue: one gas-rich dwarf, three intermediate disks, one bulge-dominated spiral, one giant spiral",
