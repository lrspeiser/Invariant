{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariant.local/schemas/open-gravity-synthetic-discovery-manifest-v1.schema.json",
  "title": "Open-Gravity synthetic discovery replay manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_release",
    "experiment_id",
    "domain",
    "data_role",
    "formula_binding_sha256",
    "adapter_sha256",
    "seeds",
    "countermodel_ids",
    "metrics",
    "claim_class"
  ],
  "properties": {
    "schema_version": {"const": "open-gravity-synthetic-discovery-manifest-1.0"},
    "suite_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "version",
        "release_sha256",
        "ontology_sha256",
        "generator_sha256",
        "observation_operator_sha256",
        "changed_feature_ids",
        "change_level",
        "response_calibrated",
        "prediction_semantics_changed"
      ],
      "properties": {
        "suite_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
        "release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ontology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation_operator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "change_level": {"enum": ["MAJOR", "MINOR", "PATCH"]},
        "response_calibrated": {"type": "boolean"}
        ,"prediction_semantics_changed": {"type": "boolean"}
      }
    },
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "domain": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "data_role": {
      "enum": ["ANALYTIC_FIXTURE", "REAL_SHAPED_SYNTHETIC"]
    },
    "formula_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "countermodel_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "claim_class": {"const": "SYNTHETIC_DIRECTIONAL_SIGNAL"}
  }
}
