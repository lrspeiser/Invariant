  "operator_contract": {
    "sky_coordinate_convention": "x_east and y_north in a local tangent plane; position angle measured north through east",
    "disk_transform": "x_major=x_east*sin(PA)+y_north*cos(PA); y_minor=-x_east*cos(PA)+y_north*sin(PA); y_disk=y_minor/cos(i)",
    "local_radial_acceleration": "g_R=max(0,-g_disk dot e_R)",
    "quasi_circular_speed": "v_c=sqrt(R*g_R)",
    "line_of_sight_velocity": "v_los=v_sys+s_rotation*v_c*sin(i)*x_major/R",
    "rotation_sign_cells": [-1.0, 1.0],
    "primary_rotation_sign_rule": "Choose the sign from the publisher receding-side convention before scoring; the opposite sign is a retained orientation control, never selected by loss.",
    "beam_convolution": "B*(I_HI*v_los)/B*I_HI using the publisher elliptical Gaussian CLEAN beam and sealed natural-weight moment-0 intensity map",
    "beam_fft_padding": "zero-pad to twice each image axis before FFT convolution and crop the central native image",
    "mask_rule": "finite MOM0, MOM1, MOM2, convolved intensity>0, MOM0>0, MOM2>0, and frozen source-numerical radial eligibility",
    "systemic_velocity_nuisance": "one analytic weighted additive offset per object and candidate, identical formula and one degree of freedom for every candidate",
    "primary_loss": "mean squared residual divided by max(MOM2,6000 m/s)^2; descriptive dispersion-scaled shape loss, explicitly not chi-square",
    "secondary_losses": ["mean absolute residual in m/s", "unweighted root-mean-square residual in m/s"],
    "response_threshold_tuning": false,
    "per_pixel_or_radial_parameter_fitting": false
  },
  "benchmark_contract": {
    "synthetic_tilted_disk_max_abs_m_s": 1e-9,
    "axisymmetric_major_axis_relative_error": 1e-12,
    "beam_constant_field_max_abs_m_s": 1e-9,
    "beam_flux_conservation_relative_error": 1e-12,
    "wcs_roundtrip_max_pixels": 1e-6,
    "face_on_projected_amplitude_max_m_s": 1e-9,
    "opposite_rotation_sign_antisymmetry_max_m_s": 1e-9
  },
  "synthetic_suite": {
