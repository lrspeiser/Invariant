{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariant:open-gravity:campaign-manifest:1.0",
  "title": "Invariant Open Gravity Frozen Response-Scored Campaign Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "campaign_id",
    "semantic_version",
    "manifest_state",
    "frozen_at_utc",
    "frozen_before_response_access",
    "response_scored_campaign",
    "registry_binding",
    "candidate_versions",
    "data_roles_and_splits",
    "parameter_cells",
    "hyperparameter_cells",
    "nuisance_cases",
    "adaptive_generation_ids",
    "transformations",
    "object_subsets",
    "observables",
    "metrics",
    "comparators",
    "repairs",
    "stopping_decisions",
    "residual_inspired_branch_ids",
    "selection_stages",
    "correction_method",
    "global_multiplicity_ledger",
    "promotion_thresholds",
    "worst_case_and_subgroup_ceilings",
    "budgets",
    "confirmation",
    "target_blind_contract",
    "session_terminal_contract",
    "zero_access_at_freeze",
    "manifest_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "invariant-open-gravity-campaign-manifest-1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "semantic_version": {"$ref": "#/$defs/semver"},
    "manifest_state": {"enum": ["FROZEN_UNRUN", "RUNNING", "ADJUDICATED_SEALED", "INVALIDATED_SEALED"]},
    "frozen_at_utc": {"type": "string", "format": "date-time"},
    "frozen_before_response_access": {"const": true},
    "response_scored_campaign": {"const": true},
    "registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "semantic_version", "foundation_receipt_sha256", "mechanism_card_set_sha256", "equivalence_ledger_sha256", "trusted_session_contract_sha256", "twell_400_ids_sha256"],
      "properties": {
        "registry_id": {"const": "GRAVITY-LIGHT-GRAMMAR-v1"},
        "semantic_version": {"const": "1.0.0"},
          "foundation_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "mechanism_card_set_sha256": {"$ref": "#/$defs/sha256"},
          "equivalence_ledger_sha256": {"$ref": "#/$defs/sha256"},
          "trusted_session_contract_sha256": {"$ref": "#/$defs/sha256"},
        "twell_400_ids_sha256": {"const": "7388f8982c5014ef6c365d00aa780ba2ecb8b8b3f6786658fb3db36b64c29c5f"}
      }
    },
    "candidate_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "card_id", "semantic_version", "anonymous_formula_id", "lane", "candidate_status", "scientific_status", "identity_class", "mechanism_kind", "mechanism_executable", "card_sha256", "formula_sha256", "configuration_sha256", "equivalence_family_id", "equivalence_fingerprint_sha256", "domain_execution"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "card_id": {"type": "string", "minLength": 1},
          "semantic_version": {"$ref": "#/$defs/semver"},
          "anonymous_formula_id": {"type": "string", "pattern": "^F[0-9]{4,}$"},
          "lane": {"enum": ["CORE", "ADJACENT", "ORTHOGONAL", "RIVALS_CONTROLS", "WILDCARD"]},
          "candidate_status": {"enum": ["REGISTERED_THEORY_ONLY", "SOURCE_BLOCKED", "READY_FOR_RESPONSE_SCORING", "QUARANTINED_REVISION_REQUIRED", "KNOWN_REWRITE_NONINDEPENDENT"]},
          "scientific_status": {"enum": ["E_ESTABLISHED", "C_CONTROLLED_UNOBSERVED_SIGNATURE", "H_HYPOTHESIS", "A_ANALOGY"]},
          "identity_class": {"enum": ["NEW_CONCEPT", "FORMULA_VARIANT", "PARAMETER_CELL", "IMPLEMENTATION", "KNOWN_REWRITE", "EMPIRICALLY_DEGENERATE"]},
          "mechanism_kind": {"enum": ["ACTION", "FIELD_EQUATIONS", "EFFECTIVE_LAW", "ACTION_PLACEHOLDER"]},
          "mechanism_executable": {"type": "boolean"},
          "card_sha256": {"$ref": "#/$defs/sha256"},
          "formula_sha256": {"$ref": "#/$defs/sha256"},
          "configuration_sha256": {"$ref": "#/$defs/sha256"},
          "equivalence_family_id": {"type": "string", "minLength": 1},
          "equivalence_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
          "domain_execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["GALAXIES", "GROUPS", "CLUSTERS", "LENSING"],
            "properties": {
              "GALAXIES": {"$ref": "#/$defs/domain_execution"},
              "GROUPS": {"$ref": "#/$defs/domain_execution"},
              "CLUSTERS": {"$ref": "#/$defs/domain_execution"},
              "LENSING": {"$ref": "#/$defs/domain_execution"}
            }
          }
        }
      }
    },
    "data_roles_and_splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_partitions", "response_partitions", "pilot_full_relation", "confirmation_forbidden_in_campaign"],
      "properties": {
        "source_partitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_partition"}},
        "response_partitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_partition"}},
        "pilot_full_relation": {"enum": ["DISJOINT", "PROPERLY_NESTED_WITH_FULL_PROCEDURE_CORRECTION"]},
        "confirmation_forbidden_in_campaign": {"const": true}
      }
    },
    "parameter_cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozen_cell"}},
    "hyperparameter_cells": {"type": "array", "items": {"$ref": "#/$defs/frozen_cell"}},
    "nuisance_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozen_cell"}},
    "adaptive_generation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transformations": {"type": "array", "items": {"$ref": "#/$defs/hashed_named_item"}},
    "object_subsets": {"type": "array", "items": {"$ref": "#/$defs/hashed_named_item"}},
    "observables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_named_item"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_named_item"}},
    "comparators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_named_item"}},
    "repairs": {"type": "array", "items": {"$ref": "#/$defs/hashed_named_item"}},
    "stopping_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_named_item"}},
    "residual_inspired_branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selection_stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashed_named_item"}},
    "correction_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_id", "exact_rule", "selection_adjusted_reporting", "global_sequential_evidence_budget_units"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "exact_rule": {"type": "string", "minLength": 1},
        "selection_adjusted_reporting": {"const": true},
        "global_sequential_evidence_budget_units": {"type": "integer", "minimum": 1}
      }
    },
    "global_multiplicity_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_id", "campaign_sequence", "previous_manifest_sha256", "never_resets", "counts_before", "counts_this_campaign", "counts_after"],
      "properties": {
        "ledger_id": {"const": "OPEN-GRAVITY-GLOBAL-MULTIPLICITY-v1"},
        "campaign_sequence": {"type": "integer", "minimum": 1},
        "previous_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"const": "GENESIS"}]},
        "never_resets": {"const": true},
        "counts_before": {"$ref": "#/$defs/multiplicity_counts"},
        "counts_this_campaign": {"$ref": "#/$defs/multiplicity_counts"},
        "counts_after": {"$ref": "#/$defs/multiplicity_counts"}
      }
    },
    "promotion_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_constants_required", "minimum_meaningful_improvement", "selection_adjusted_evidence_threshold", "leave_one_object_out_minimum", "minimum_object_breadth", "minimum_domain_breadth"],
      "properties": {
        "shared_constants_required": {"const": true},
        "minimum_meaningful_improvement": {"type": "number", "minimum": 0},
        "selection_adjusted_evidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "leave_one_object_out_minimum": {"type": "number"},
        "minimum_object_breadth": {"type": "integer", "minimum": 1},
        "minimum_domain_breadth": {"type": "integer", "minimum": 1}
      }
    },
    "worst_case_and_subgroup_ceilings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ceiling_id", "metric_id", "scope", "maximum"],
        "properties": {
          "ceiling_id": {"type": "string", "minLength": 1},
          "metric_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "maximum": {"type": "number"}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_candidate_limits", "revision_limit", "compute_cost_ceiling", "network_cost_ceiling", "model_cost_ceiling", "paid_cost_ceiling"],
      "properties": {
        "lane_candidate_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CORE", "ADJACENT", "ORTHOGONAL", "RIVALS_CONTROLS", "WILDCARD"],
          "properties": {
            "CORE": {"type": "integer", "minimum": 0},
            "ADJACENT": {"type": "integer", "minimum": 0},
            "ORTHOGONAL": {"type": "integer", "minimum": 0},
            "RIVALS_CONTROLS": {"type": "integer", "minimum": 0},
            "WILDCARD": {"type": "integer", "minimum": 0}
          }
        },
        "revision_limit": {"type": "integer", "minimum": 0},
        "compute_cost_ceiling": {"type": "string", "minLength": 1},
        "network_cost_ceiling": {"type": "number", "const": 0},
        "model_cost_ceiling": {"type": "number", "const": 0},
        "paid_cost_ceiling": {"type": "number", "const": 0}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["K", "evidence_budget_units_total", "slots", "opened_slots", "independent_reduction_required"],
      "properties": {
        "K": {"type": "integer", "minimum": 1},
        "evidence_budget_units_total": {"type": "integer", "minimum": 1},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot_id", "evidence_budget_units", "sealed", "opened", "candidate_id"],
            "properties": {
              "slot_id": {"type": "string", "pattern": "^K[0-9]+$"},
              "evidence_budget_units": {"type": "integer", "minimum": 1},
              "sealed": {"const": true},
              "opened": {"const": false},
              "candidate_id": {"type": "null"}
            }
          }
        },
        "opened_slots": {"const": 0},
        "independent_reduction_required": {"const": true}
      }
    },
    "target_blind_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anonymous_formula_identifiers", "anonymous_object_identifiers", "target_class_switches_allowed", "object_specific_gravity_tuning_allowed", "score_feedback_to_formula_authors_before_batch_close", "theory_author_may_adjudicate_own_candidate", "legitimate_source_metadata_visible", "forbidden_generation_inputs", "sealed_formula_mapping_sha256", "sealed_object_mapping_sha256"],
      "properties": {
        "anonymous_formula_identifiers": {"const": true},
        "anonymous_object_identifiers": {"const": true},
        "target_class_switches_allowed": {"const": false},
        "object_specific_gravity_tuning_allowed": {"const": false},
        "score_feedback_to_formula_authors_before_batch_close": {"const": false},
        "theory_author_may_adjudicate_own_candidate": {"const": false},
        "legitimate_source_metadata_visible": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_generation_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sealed_formula_mapping_sha256": {"$ref": "#/$defs/sha256"},
        "sealed_object_mapping_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "session_terminal_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "trusted_session_contract_sha256", "terminal_ledger_contract_sha256", "campaign_execution_authority", "response_scored_campaign_limit", "response_scored_campaign_ordinal", "automatic_second_campaign_allowed", "on_adjudication", "post_freeze_new_or_repaired_idea_destination", "zero_survivors_allowed"],
      "properties": {
        "session_id": {"const": "OPEN-GRAVITY-DISCOVERY-SESSION-2026-08-30"},
        "trusted_session_contract_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_ledger_contract_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_execution_authority": {"const": "WITHHELD_PENDING_PERSISTED_TERMINAL_LEDGER"},
        "response_scored_campaign_limit": {"const": 1},
        "response_scored_campaign_ordinal": {"const": 1},
        "automatic_second_campaign_allowed": {"const": false},
        "on_adjudication": {"const": "SESSION_TERMINAL"},
        "post_freeze_new_or_repaired_idea_destination": {"const": "IDEA-RESERVOIR-v1"},
        "zero_survivors_allowed": {"const": true}
      }
    },
    "zero_access_at_freeze": {"$ref": "#/$defs/zero_access"},
    "manifest_content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "role", "anonymous_object_ids", "object_ledger_sha256", "data_contract_sha256"],
      "properties": {
        "partition_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["SOURCE_ONLY", "DEVELOPMENT_PILOT", "DEVELOPMENT_FULL", "CONFIRMATION_SEALED", "INDEPENDENT_SEALED"]},
        "anonymous_object_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^O[0-9]{4,}$"}
        },
        "object_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "data_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frozen_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "exact_value_or_rule", "frozen"],
      "properties": {
        "cell_id": {"type": "string", "minLength": 1},
        "exact_value_or_rule": {},
        "frozen": {"const": true}
      }
    },
    "hashed_named_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "definition", "implementation_sha256"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "domain_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "execution_disposition", "scored", "source_contract_sha256"],
      "properties": {
        "eligible": {"type": "boolean"},
        "execution_disposition": {"enum": ["SEALED_UNOPENED_FOR_SCORING", "SOURCE_BLOCKED", "THEORY_ONLY", "QUARANTINED", "KNOWN_REWRITE_NONINDEPENDENT", "NOT_APPLICABLE"]},
        "scored": {"const": false},
        "source_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "multiplicity_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_scored_campaigns",
        "response_planned_campaigns",
        "adaptive_generations",
        "concepts",
        "registered_candidate_rows",
        "equivalence_families",
        "formula_variants",
        "parameter_cells",
        "hyperparameter_cells",
        "nuisance_scenarios",
        "transformations",
        "object_subsets",
        "observables",
        "metrics",
        "repairs",
        "stopping_decisions",
        "residual_inspired_branches",
        "selection_stages",
        "response_planned_formula_variants",
        "response_planned_domain_executions",
        "response_scored_formula_variants",
        "response_scored_domain_executions"
      ],
      "properties": {
        "response_scored_campaigns": {"type": "integer", "minimum": 0},
        "response_planned_campaigns": {"type": "integer", "minimum": 0},
        "adaptive_generations": {"type": "integer", "minimum": 0},
        "concepts": {"type": "integer", "minimum": 0},
        "registered_candidate_rows": {"type": "integer", "minimum": 0},
        "equivalence_families": {"type": "integer", "minimum": 0},
        "formula_variants": {"type": "integer", "minimum": 0},
        "parameter_cells": {"type": "integer", "minimum": 0},
        "hyperparameter_cells": {"type": "integer", "minimum": 0},
        "nuisance_scenarios": {"type": "integer", "minimum": 0},
        "transformations": {"type": "integer", "minimum": 0},
        "object_subsets": {"type": "integer", "minimum": 0},
        "observables": {"type": "integer", "minimum": 0},
        "metrics": {"type": "integer", "minimum": 0},
        "repairs": {"type": "integer", "minimum": 0},
        "stopping_decisions": {"type": "integer", "minimum": 0},
        "residual_inspired_branches": {"type": "integer", "minimum": 0},
        "selection_stages": {"type": "integer", "minimum": 0},
        "response_planned_formula_variants": {"type": "integer", "minimum": 0},
        "response_planned_domain_executions": {"type": "integer", "minimum": 0},
        "response_scored_formula_variants": {"type": "integer", "minimum": 0},
        "response_scored_domain_executions": {"type": "integer", "minimum": 0}
      }
    },
    "zero_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific_response_files_opened", "scientific_response_rows_opened", "development_response_rows_opened", "group_response_rows_opened", "lensing_response_rows_opened", "confirmation_rows_opened", "independent_rows_opened", "scientific_scores_computed", "network_calls", "model_calls", "paid_calls"],
      "properties": {
        "scientific_response_files_opened": {"const": 0},
        "scientific_response_rows_opened": {"const": 0},
        "development_response_rows_opened": {"const": 0},
        "group_response_rows_opened": {"const": 0},
        "lensing_response_rows_opened": {"const": 0},
        "confirmation_rows_opened": {"const": 0},
        "independent_rows_opened": {"const": 0},
        "scientific_scores_computed": {"const": 0},
        "network_calls": {"const": 0},
        "model_calls": {"const": 0},
        "paid_calls": {"const": 0}
      }
    }
  }
}
