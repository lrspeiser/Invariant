  "transformation_contract": {
    "tdf_reconstruction": {
      "three_part_formula": "H*1e6 + I*1e1 + L*1e-6",
      "component_type": "unsigned_24_bit_MSB",
      "sample_interval_input_unit": "centisecond",
      "doppler_output": "count/sample_interval_second",
      "range_type_1": "reconstructed_value*1e-9 second",
      "range_unit_S": "reconstructed_value*0.5e-18*f_sky second",
