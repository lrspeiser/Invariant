      "range_unit_X_BLOCK_V": "reconstructed_value*(221/1498)e-18*f_sky second"
    },
    "rsr_reconstruction": {
      "phase": "unwrap(atan2(Q,I)) with adjacent principal step strictly below 0.95*pi",
      "frequency": "least_squares_phase_slope/(2*pi)",
      "phase_jacobian": "dphase/dI=-Q/(I^2+Q^2), dphase/dQ=I/(I^2+Q^2)",
      "input_unit": "dimensionless_odd_integer_ADC_code_after_2k_plus_1_bias",
      "time_unit": "sample/sample_rate_hz"
    },
    "calibration_signs": {
      "round_trip_light_time_s": "raw-clock-troposphere-ionosphere-solar_plasma-station_path-station_geometry",
      "coherent_carrier_frequency_hz": "reference+residual-reference*oscillator_fraction-propagation_shift-station_geometry_shift",
      "carrier_phase_rad": "raw-2*pi*reference*total_delay-instrument_phase-2*pi*reference*duration*oscillator_fraction"
    },
    "covariance": {
      "method": "C_out=C_raw+J_nuisance*C_nuisance*J_nuisance^T",
      "requirements": [
        "finite symmetric positive-semidefinite covariance",
        "raw I/Q Jacobian retained",
        "shared calibration cross-correlations retained",
        "output order and units retained"
      ],
      "nuisance_labels": [
        "clock_offset_s",
        "instrument_phase_offset_rad",
        "ionosphere_delay_s",
        "oscillator_fractional_error",
        "propagation_frequency_shift_hz",
        "solar_plasma_delay_s",
        "station_geometry_delay_s",
        "station_geometry_frequency_shift_hz",
        "station_path_delay_s",
        "troposphere_delay_s"
      ]
    },
    "time_tags": {
      "system": "UTC",
      "association": "absolute TDF-RSR epoch separation must not exceed preregistered window"
    },
    "negative_controls": [
      "unit mismatch",
      "nonfinite or zero I/Q amplitude",
      "phase branch ambiguity",
      "nonpositive sample interval or sample rate",
      "malformed or non-UTC time tag",
      "TDF-RSR association-window violation",
