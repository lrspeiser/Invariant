{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invariant:open-gravity:idea-reservoir:1.0",
  "title": "Invariant Open Gravity Append-Only Idea Reservoir v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reservoir_id",
    "semantic_version",
    "append_only",
    "entry_hash_algorithm",
    "genesis_sha256",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "invariant-open-gravity-idea-reservoir-1.0"},
    "reservoir_id": {"const": "IDEA-RESERVOIR-v1"},
    "semantic_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "append_only": {"const": true},
    "entry_hash_algorithm": {"const": "sha256-canonical-json-without-entry-sha256"},
    "genesis_sha256": {"const": "75efef4b47d63dac14b88e02cdb732bf140e4dc9bf088d5e055f00c7d6b81198"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idea_id",
        "entry_version",
        "created_at_utc",
        "created_by",
        "lineage",
        "origin_timing",
        "residual_source_campaigns",
        "summary",
        "hypothesis",
        "intended_ontology",
        "mechanism_card_id",
        "current_state",
        "eligible_campaign",
        "current_campaign_scoring_allowed",
        "previous_same_idea_entry_sha256",
        "previous_entry_sha256",
        "entry_sha256"
      ],
      "properties": {
        "idea_id": {"type": "string", "pattern": "^IDEA-[A-Z0-9][A-Z0-9._-]*$"},
        "entry_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "minLength": 1},
        "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "origin_timing": {"enum": ["PRE_RESPONSE", "ADAPTIVE_DEVELOPMENT"]},
        "residual_source_campaigns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "summary": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "intended_ontology": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mechanism_card_id": {"type": ["string", "null"]},
        "current_state": {"enum": ["INCOMPLETE_QUARANTINE", "SOURCE_BLOCKED", "READY_FOR_FUTURE_CAMPAIGN", "KNOWN_REWRITE"]},
        "eligible_campaign": {"const": "FUTURE_ONLY"},
        "current_campaign_scoring_allowed": {"const": false},
        "previous_same_idea_entry_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "previous_entry_sha256": {"$ref": "#/$defs/sha256"},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
