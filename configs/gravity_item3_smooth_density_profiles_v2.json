    "mean_log_amplitude": "m=(log10(u_surface)+log10(u_volume))/2",
    "log_contrast": "c=log10(u_surface)-log10(u_volume)",
    "rewrite_identity": "c=log10(3H/(2r)); contrast alone is a nonqualifying radial-scale control",
    "transition_kernel": "w(u)=u/(1+u)^2",
    "qualifying_interactions": [
      "m*c",
      "log10(gbar/g_dagger)*m",
      "log10(gbar/g_dagger)*c",
      "w(u_surface)*w(u_volume)",
      "(w(u_surface)-w(u_volume))/(w(u_surface)+w(u_volume))"
    ]
