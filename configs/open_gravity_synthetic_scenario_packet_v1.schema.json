{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariant.local/schemas/open-gravity-synthetic-scenario-packet-v1.schema.json",
  "title": "Open-Gravity synthetic scenario packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "object_id",
    "experiment_id",
    "domain",
    "geometry_mode",
    "time_mode",
    "coordinate_frame",
    "axes",
    "formula_features",
    "scoring_responses",
    "hidden_truth",
    "expected_predictions",
    "uncertainties",
    "anchors",
    "seed_lineage"
  ],
  "properties": {
    "schema_version": {"const": "open-gravity-synthetic-scenario-packet-1.0"},
    "scenario_id": {"$ref": "#/$defs/id"},
    "object_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "domain": {"$ref": "#/$defs/id"},
    "geometry_mode": {"$ref": "#/$defs/id"},
    "time_mode": {"$ref": "#/$defs/id"},
    "coordinate_frame": {"$ref": "#/$defs/id"},
    "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/axis"}},
    "formula_features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
    "scoring_responses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
    "hidden_truth": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
    "expected_predictions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prediction"}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uncertainty"}},
    "anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/anchor"}},
    "seed_lineage": {"$ref": "#/$defs/seedLineage"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "length", "coordinate_element_id", "coordinate_sha256"],
      "properties": {
        "axis_id": {"$ref": "#/$defs/id"},
        "length": {"type": "integer", "minimum": 1},
        "coordinate_element_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "coordinate_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"coordinate_element_id": {"type": "null"}}},
          "then": {"properties": {"coordinate_sha256": {"type": "null"}}},
          "else": {"properties": {"coordinate_sha256": {"$ref": "#/$defs/hash"}}}
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "artifact_path", "value_sha256", "dtype", "shape", "axes", "unit", "frame"],
      "properties": {
        "element_id": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "value_sha256": {"$ref": "#/$defs/hash"},
        "dtype": {"enum": ["bool", "float32", "float64", "int32", "int64", "uint8", "uint32"]},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "unit": {"type": "string", "minLength": 1},
        "frame": {"type": "string", "minLength": 1}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "artifact_path", "dtype", "shape", "axes", "unit", "frame"],
      "properties": {
        "element_id": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "dtype": {"enum": ["bool", "float32", "float64", "int32", "int64", "uint8", "uint32"]},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "unit": {"type": "string", "minLength": 1},
        "frame": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty_id", "applies_to_element_id", "representation", "artifact_path", "artifact_sha256"],
      "properties": {
        "uncertainty_id": {"$ref": "#/$defs/id"},
        "applies_to_element_id": {"$ref": "#/$defs/id"},
        "representation": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "artifact_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/id"},
        "artifact_path": {"$ref": "#/$defs/path"},
        "artifact_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "seedLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_seed", "scenario_id", "object_id", "truth_world_id", "nuisance_draw", "operator_draw"],
      "properties": {
        "suite_seed": {"type": "integer", "minimum": 0},
        "scenario_id": {"$ref": "#/$defs/id"},
        "object_id": {"$ref": "#/$defs/id"},
        "truth_world_id": {"$ref": "#/$defs/id"},
        "nuisance_draw": {"type": "integer", "minimum": 0},
        "operator_draw": {"type": "integer", "minimum": 0}
      }
    }
  }
}
