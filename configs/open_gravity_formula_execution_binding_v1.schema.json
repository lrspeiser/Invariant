{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariant.local/schemas/open-gravity-formula-execution-binding-v1.schema.json",
  "title": "Open-Gravity formula execution binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi_version",
    "binding_id",
    "formula_id",
    "formula_version",
    "formula_sha256",
    "status",
    "entrypoint",
    "required_features",
    "optional_features",
    "emitted_features",
    "domains",
    "geometry_support",
    "time_support",
    "parameter_schema_path",
    "parameter_schema_sha256",
    "approximation_ceiling",
    "health_gates",
    "resource_bounds"
  ],
  "properties": {
    "abi_version": {"const": "open-gravity-formula-execution-1.0"},
    "binding_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "formula_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "formula_version": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"},
    "formula_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": ["EXECUTABLE", "UNADAPTED", "THEORY_ONLY", "SOURCE_BLOCKED", "QUARANTINED"]
    },
    "entrypoint": {
      "oneOf": [
        {"type": "string", "pattern": "^sigma_theory_compiler\\.[a-z][a-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"},
        {"type": "null"}
      ]
    },
    "required_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "optional_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "emitted_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "geometry_support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "time_support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "parameter_schema_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "parameter_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approximation_ceiling": {"type": "string", "minLength": 1},
    "health_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$"}},
    "resource_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_seconds", "max_memory_bytes", "max_output_bytes"],
      "properties": {
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "EXECUTABLE"}}},
      "then": {
        "properties": {
          "entrypoint": {"type": "string"},
          "required_features": {"minItems": 1},
          "emitted_features": {"minItems": 1}
        }
      },
      "else": {"properties": {"entrypoint": {"type": "null"}}}
    }
  ]
}
