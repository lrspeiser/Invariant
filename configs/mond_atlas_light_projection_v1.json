  "conventions": {
    "metric_signature": "(-,+,+,+)",
    "metric": "ds^2=-(1+2 Phi/c^2)c^2 dt^2+(1-2 Psi/c^2)(dx^2+dy^2+dell^2)",
    "potential_unit": "m^2 s^-2",
    "gradient_unit": "m s^-2",
    "length_unit": "m",
    "mass_unit": "kg",
    "angle_unit": "radian",
    "coordinates": "x,y are right-handed transverse physical Cartesian coordinates in one local lens plane; ell is physical longitudinal distance; rays use fixed transverse xi in the thin-lens/Born integral.",
    "alpha_hat": "c^-2 integral grad_perp(Phi+Psi) dell, outward for a negative point potential and positive impact xi; actual propagation-direction change is -alpha_hat.",
    "lens_equation": "beta(theta)=theta-(D_ls/D_s)*alpha_hat(D_l*theta)",
    "distance_rule": "D_l, D_s and D_ls are separately supplied angular-diameter distances; never replace D_ls by D_s-D_l. Local ell is not an angular-diameter distance.",
    "jacobian": "A_ij=partial beta_i/partial theta_j; signed magnification=1/det(A); flux magnification=abs(signed magnification)",
    "lewis_challinor_mapping": "Their (+---), c=1 potentials map as Psi_N=Phi/c^2 and Phi_N=-Psi/c^2; their Weyl potential is (Phi+Psi)/(2c^2). Their source-minus-image displacement is the negative of the reduced deflection used here."
  },
