  "finite_hierarchy_no_go": {
    "conclusion": "no selector inspecting only any preassigned finite factorial-moment hierarchy can uniquely select the candidate Poisson random measure",
    "count_law": "for each finite k>=1 perturb Poisson(1) on n=0,...,k+1 by exp(-1)*(-1)^n*C(k+1,n)/(2*(k+1)!)",
    "finite_difference_identity": "sum_{n=0}^{k+1}(-1)^n*C(k+1,n)*(n)_j=0 for 0<=j<=k",
    "first_difference": "at j=k+1 the factorial-moment perturbation is (-1)^(k+1)*exp(-1)/2, which is nonzero",
    "normalization_and_positivity": "the signed perturbation sums to zero; its magnitude is at most half the Poisson mass at every modified n, so all probabilities stay positive",
    "point_process_lift": "on diffuse B with mu(B)=1, place the perturbed count iid with law mu_B and use an independent PRM outside; factorial moment measures alpha_j equal mu^tensor_j for every 1<=j<=k but differ on B^(k+1)",
    "scope_limit": "the theorem varies the counterexample with k and does not assert that one law matches every order, nor that an infinite moment hierarchy is determinate without an analytic or exponential-integrability premise",
    "theorem_name": "arbitrary_finite_factorial_hierarchy_nonidentifiability"
  },
