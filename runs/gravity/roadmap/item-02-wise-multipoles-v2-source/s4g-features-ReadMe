    r                = Inner ring
    r', _rs, rs, r_s = Inner pseudo-ring
    _rl, rl, r_l     = Inner ringlens
    _r'l, r'l, r'_l  = Inner pseudo-ringlens
    l, ls, sl        = Inner lens
