ale_factor":0.954,"snap":88},{"redshift":0.0,"scale_factor":1.0,"snap":90}]},"eligibility_gates":{"cryptographic_payload_checksums_available":false,"direct_hydro_and_nbody_trees":true,"direct_hydro_groups":true,"direct_hydro_snapshots":true,"direct_nbody_groups":false,"direct_nbody_snapshots":true,"documented_cross_tree_object_matching":false,"exact_same_ic_pair":true,"first_pericenter_timing_equivalent_to_tng100":false,"major_merger_intervals_identifiable":true,"required_hydro_fields_documented":true},"field_mapping":{"cross_run_matching":"The public z=0 Group_matching file is present, but official documentation inspected here does not freeze its dataset schema or establish a per-subhalo cross-tree identifier at every snapshot. Same simulation seed alone is not object-level matching.","gas_receiver_and_controls":["PartType0/Coordinates","PartType0/Velocities","PartType0/Masses","PartType0/Density","PartType0/InternalEnergy","PartType0/GFM_CoolingRate","PartType0/EnergyDissipation","PartType0/Machnumber","PartType0/Potential","PartType0/StarFormationRate"],"major_merger_topology":["SubLink DescendantID","FirstProgenitorID","NextProgenitorID","SnapNum","SubhaloMassType or group-catalog SubhaloMassType"],"orbital_energy_and_angular_momentum":["SubhaloPos","SubhaloVel","SubhaloMassType","snapshot PartType1/Potential","snapshot Header/MassTable for constant IllustrisTNG DM particle mass"],"particle_membership":"Hydro IllustrisTNG snapshots are SUBFIND-ordered. IllustrisTNG_DM is treated as a non-IllustrisTNG snapshot and requires the /IDs membership block from its group catalog.","subhalo_nuisance_fields":["SubhaloHalfmassRadType","SubhaloVelDisp","SubhaloSpin","SubhaloSFR","SubhaloLenType","SubhaloGrNr"]},"local_sha256_acquisition_count":1,"official_cryptographic_checksum_count":0,"schema":"invariant-open-gravity-camels-source-manifest-1.0","scientific_rows_opened":0,"scientific_scores_computed":0}
