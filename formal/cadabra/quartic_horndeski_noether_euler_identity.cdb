{a,b,c,d}::Indices(position=free).
x::Coordinate.
g_{a b}::Metric.
g^{a b}::InverseMetric.
\nabla{#}::Derivative.
E_{a b}::Symmetric.
Q::Depends(x,\nabla{#}).
p_{a}::Depends(x,\nabla{#}).
\xi^{a}::Depends(x,\nabla{#}).

# Euler convention delta S=integral(E_ab delta g^ab+Q delta phi).
variation := \int{-2 E_{a b} \nabla^{a}{\xi^{b}} + Q \xi^{b} p_{b}}{x};
integrate_by_parts(variation, $\xi^{b}$);
product_rule(variation);
distribute(variation);
canonicalise(variation);
rename_dummies(variation);
sort_product(variation);

expected := \int{2 \nabla^{a}{E_{a}^{b}} \xi_{b} + Q \xi^{a} p_{a}}{x};
canonicalise(expected);
rename_dummies(expected);
sort_product(expected);
residual := @(variation) - @(expected);
canonicalise(residual);
rename_dummies(residual);
collect_terms(residual);
assert(residual == 0)

corrupted := \int{-2 \nabla^{a}{E_{a}^{b}} \xi_{b} + Q \xi^{a} p_{a}}{x};
negative := @(variation) - @(corrupted);
canonicalise(negative);
rename_dummies(negative);
collect_terms(negative);
assert(negative != 0)

print("SIGMA_QUARTIC_HORNDESKI_NOETHER_EULER_COEFFICIENT_DERIVED");
print("SIGMA_QUARTIC_HORNDESKI_NOETHER_CORRUPTED_SIGN_REJECTED");
print(residual);
