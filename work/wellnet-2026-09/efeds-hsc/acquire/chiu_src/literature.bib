@article{Sereno2017,
abstract = {Multi-wavelength techniques can probe the distribution and the physical properties of baryons and dark matter in galaxy clusters from the inner regions out to the peripheries. We present a full three-dimensional analysis combining strong and weak lensing, X-ray surface brightness and temperature, and the Sunyaev-Zel'dovich effect. The method is applied to MACS J1206.2-0847, a remarkably regular, face-on, massive, M{\_}{\{}200{\}}=(1.1+-0.2)*10{\^{}}{\{}15{\}}M{\_}Sun/h, cluster at z=0.44. The measured concentration, c{\_}{\{}200{\}}=6.3+-1.2, and the triaxial shape are common to halos formed in a LCDM scenario. The gas has settled in and follows the shape of the gravitational potential, which is evidence of pressure equilibrium via the shape theorem. There is no evidence for significant non-thermal pressure and the equilibrium is hydrostatic.},
archivePrefix = {arXiv},
arxivId = {1702.00795},
author = {Sereno, Mauro and Ettori, Stefano and Meneghetti, Massimo and Sayers, Jack and Umetsu, Keiichi and Merten, Julian and Chiu, I-Non and Zitrin, Adi},
doi = {10.1093/mnras/stx326},
eprint = {1702.00795},
issn = {0035-8711},
journal = {Monthly Notices of the Royal Astronomical Society, Volume 467, Issue 4, p.3801-3826},
keywords = {galaxies: clusters: general,galaxies: clusters: individual: MACS J1206.2-0847,galaxies: clusters: intracluster medium,gravitational lensing: weak},
month = {feb},
pages = {3801--3826},
title = {{CLUMP-3D. Three dimensional lensing and multi-probe analysis of MACS J1206.2-0847, a remarkably regular cluster}},
url = {http://arxiv.org/abs/1702.00795 http://dx.doi.org/10.1093/mnras/stx326},
volume = {467},
year = {2017}
}
