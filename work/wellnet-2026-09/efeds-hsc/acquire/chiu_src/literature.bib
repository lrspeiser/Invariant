journal = {The Astrophysical Journal, Volume 756, Issue 2, article id. 128, 11 pp. (2012).},
keywords = {X-rays: general,atomic data,atomic processes},
month = {jul},
title = {{Updated Atomic Data and Calculations for X-ray Spectroscopy}},
