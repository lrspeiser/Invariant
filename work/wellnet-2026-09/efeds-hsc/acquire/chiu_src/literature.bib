@article{Czakon2014,
abstract = {We present scaling relations between the integrated Sunyaev-Zel'dovich Effect (SZE) signal, {\$}Y{\_}{\{}\backslashrm SZ{\}}{\$}, its X-ray analogue, {\$}Y{\_}{\{}\backslashrm X{\}}\backslashequiv M{\_}{\{}\backslashrm gas{\}}T{\_}{\{}\backslashrm X{\}}{\$}, and total mass, {\$}M{\_}{\{}\backslashrm tot{\}}{\$}, for the 45 galaxy clusters in the Bolocam X-ray-SZ (BOXSZ) sample. All parameters are integrated within {\$}r{\_}{\{}2500{\}}{\$}. {\$}Y{\_}{\{}2500{\}}{\$} values are measured using SZE data collected with Bolocam, operating at 140 GHz at the Caltech Submillimeter Observatory (CSO). The temperature, {\$}T{\_}{\{}\backslashrm X{\}}{\$}, and mass, {\$}M{\_}{\{}\backslashrm gas,2500{\}}{\$}, of the intracluster medium are determined using X-ray data collected with Chandra, and {\$}M{\_}{\{}\backslashrm tot{\}}{\$} is derived from {\$}M{\_}{\{}\backslashrm gas{\}}{\$} assuming a constant gas mass fraction. Our analysis accounts for several potential sources of bias, including: selection effects, contamination from radio point sources, and the loss of SZE signal due to noise filtering and beam-smoothing effects. We measure the {\$}Y{\_}{\{}2500{\}}{\$}--{\$}Y{\_}{\{}\backslashrm X{\}}{\$} scaling to have a power-law index of {\$}0.84\backslashpm0.07{\$}, and a fractional intrinsic scatter in {\$}Y{\_}{\{}2500{\}}{\$} of {\$}(21\backslashpm7)\backslash{\%}{\$} at fixed {\$}Y{\_}{\{}\backslashrm X{\}}{\$}, both of which are consistent with previous analyses. We also measure the scaling between {\$}Y{\_}{\{}2500{\}}{\$} and {\$}M{\_}{\{}2500{\}}{\$}, finding a power-law index of {\$}1.06\backslashpm0.12{\$} and a fractional intrinsic scatter in {\$}Y{\_}{\{}2500{\}}{\$} at fixed mass of {\$}(25\backslashpm9)\backslash{\%}{\$}. While recent SZE scaling relations using X-ray mass proxies have found power-law indices consistent with the self-similar prediction of 5/3, our measurement stands apart by differing from the self-similar prediction by approximately 5{\$}\backslashsigma{\$}. Given the good agreement between the measured {\$}Y{\_}{\{}2500{\}}{\$}--{\$}Y{\_}{\{}\backslashrm X{\}}{\$} scalings, much of this discrepancy appears to be caused by differences in the calibration of the X-ray mass proxies adopted for each particular analysis.},
archivePrefix = {arXiv},
arxivId = {1406.2800},
author = {Czakon, N. G. and Sayers, J. and Mantz, A. and Golwala, S. R. and Downes, T. P. and Koch, P. M. and Lin, K. -Y. and Molnar, S. M. and Moustakas, L. A. and Mroczkowski, T. and Pierpaoli, E. and Shitanishi, J. A. and Siegel, S. and Umetsu, K.},
doi = {10.1088/0004-637X/806/1/18},
eprint = {1406.2800},
issn = {0004-637X},
journal = {The Astrophysical Journal, Volume 806, Issue 1, article id. 18, 28 pp. (2015).},
keywords = {galaxies: clusters: general,galaxies: clusters: intracluster medium},
month = {jun},
title = {{Galaxy Cluster Scaling Relations between Bolocam Sunyaev-Zel'dovich Effect and Chandra X-ray Measurements}},
url = {http://arxiv.org/abs/1406.2800 http://dx.doi.org/10.1088/0004-637X/806/1/18},
volume = {806},
year = {2014}
}
