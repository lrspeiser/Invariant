 ptype 0 eq ptype 3 eq or {
     bang dang add dang eang {
 	dup sin exch cos
 	/xv exch orad mul def
 	/yv exch orad mul def
 	xv yv lineto
     } for
     closepath
     ptype 0 eq {stroke} if
     ptype 3 eq {gsave
 	fill grestore
     } if
 } if
