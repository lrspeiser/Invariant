	Keywords = {Astrometry, Magellanic Clouds, Metallicity, Planetary Nebulae, Red Shift, Stellar Temperature, Balmer Series, Galactic Bulge, H Beta Line, Hubble Constant, Optical Thickness, Stellar Evolution, Stellar Luminosity},
