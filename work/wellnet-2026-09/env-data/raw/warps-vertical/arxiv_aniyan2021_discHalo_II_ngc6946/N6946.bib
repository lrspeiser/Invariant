	Eprint = {astro-ph/9902227},
	Journal = {\aap},
	Keywords = {GALAXIES: PHOTOMETRY, GALAXIES: SPIRAL, GALAXIES: STAR CLUSTERS},
	Month = may,
	Pages = {59-72},
	Title = {{Young massive star clusters in nearby galaxies . I. Identification and general properties of the cluster systems}},
	Volume = 345,
	Year = 1999,
	Bdsk-File-1 = {},
