	Journal = {AJ},
	Keywords = {Stars: Color-Magnitude Diagrams, Stars: Hertzsprung-Russell Diagram, Stars: Formation},
	Month = sep,
	Pages = {1465-1477},
	Title = {{IAC-STAR: A Code for Synthetic Color-Magnitude Diagram Computation}},
