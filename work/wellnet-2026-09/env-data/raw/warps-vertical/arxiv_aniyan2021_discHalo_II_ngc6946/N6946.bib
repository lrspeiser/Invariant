	Eprint = {astro-ph/0004210},
	Journal = {ArXiv Astrophysics e-prints},
	Keywords = {Astrophysics},
	Month = apr,
	Title = {{The saturation of disk heating in the solar neighborhood and evidence for a merger 9 Gyrs ago}},
	Year = 2000,
