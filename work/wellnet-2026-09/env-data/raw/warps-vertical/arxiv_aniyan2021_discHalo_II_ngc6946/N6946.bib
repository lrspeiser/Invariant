@inproceedings{Toomre:81,
	Abstract = {The process of swing amplification is discussed as a possible mechanism to account for the spiral structure of galaxies. The mechanism is proposed to occur in a thin infinite disk of stars with a Gaussian spread of radial velocities orbiting in a force field corresponding to the flattest imaginable law of circular motion, with half of the central force field coming from a rigid and fixed spheroidal halo, which is subject to disturbances resulting from weak, transient external quadrupole forces revolving counterclockwise with the same angular speed as the test particles in the outermost circles. The amplification is shown to result from a combination of galactic shear flow, epicyclic shaking and self-gravity, and to be characterized by oscillations with amplitudes about four times larger than kinematic and arms wound more tightly and of greater density than kinematic features. The unstable spiral modes of a Gaussian disk are then examined, and implications of the swing amplification theory for the prevention of violent bar-making instabilities of disks and the lifetimes of the spiral patterns in normal spirals such as M51 and M81 are noted.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/1981seng.proc..111T},
	Author = {{Toomre}, A.},
	Booktitle = {Structure and Evolution of Normal Galaxies},
	Date-Added = {2017-05-05 02:23:27 +0000},
	Date-Modified = {2017-05-05 02:23:34 +0000},
	Editor = {{Fall}, S.~M. and {Lynden-Bell}, D.},
	Keywords = {Galactic Structure, Rotating Disks, Spiral Galaxies, Star Distribution, Stellar Motions, Gravitational Effects, Halos, Radial Velocity, Shear Flow},
	Pages = {111-136},
	Title = {{What amplifies the spirals}},
	Year = 1981,
	Bdsk-Url-1 = {http://adsabs.harvard.edu/abs/1981seng.proc..111T}}

@article{Athanassoula:87,
	Abstract = {The present analysis of rotation curves for a sample of spiral galaxies whose photometric and kinematical data are available obtains the photometric radial luminosity, in order to calculate a rotation curve due to the luminous mass in a galaxy. The range of possible M/L values is narrowed by introducing spiral structure constraints, thereby restricting the allowed values for the disk to a range of 0.3 dex. The gas fraction in the luminous mass of the models is calculated on the basis of available (C-12)O data, in order to estimate the contribution of molecular hydrogen. It is suggested that all galaxies need a halo in order to fit their rotation curve, and that cases to the contrary are due to the artificially short radius range of the rotation data. The central density of the isothermal sphere correlates with the central disk surface density divided by disk characteristic length.},
