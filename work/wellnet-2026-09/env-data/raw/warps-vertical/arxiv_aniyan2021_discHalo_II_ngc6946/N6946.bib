	Archiveprefix = {arXiv},
	Arxivurl = {http://arXiv.org/abs/1212.6182},
	Author = {{Zacharias}, N. and {Finch}, C.~T. and {Girard}, T.~M. and {Henden}, A. and {Bartlett}, J.~L. and {Monet}, D.~G. and {Zacharias}, M.~I.},
	Date-Added = {2015-03-25 02:41:45 +0000},
	Date-Modified = {2015-07-23 05:22:33 +0000},
	Doi = {10.1088/0004-6256/145/2/44},
	Eid = {44},
