	Eprint = {astro-ph/0204154},
	Journal = {\mnras},
	Keywords = {galaxies: fundamental parameters, galaxies: photometry, galaxies: spiral, galaxies: stellar content, galaxies: structure},
	Month = aug,
	Pages = {646-668},
	Title = {{Flattening and truncation of stellar discs in edge-on spiral galaxies}},
	Volume = 334,
	Year = 2002,
