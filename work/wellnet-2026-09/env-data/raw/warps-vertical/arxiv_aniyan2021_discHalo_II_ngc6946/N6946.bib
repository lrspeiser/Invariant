@article{Shapiro:02,
	Abstract = {Current data suggest that the central mass densities rho0 and phase-space densities Q≡rho0/sigma3V of cosmological halos in the present universe are correlated with their velocity dispersions sigmaV over a very wide range of sigmaV from less than 10 to more than 1000 km s-1. Such correlations are an expected consequence of the statistical correlation of the formation epochs of virialized objects in the cold dark matter (CDM) model with their masses; the smaller mass halos typically form first and merge to form larger mass halos later. We have derived the Q-sigmaV and rho0-sigmaV correlations for different CDM cosmologies and compared the predicted correlations with the observed properties of a sample of low-redshift halos ranging in size from dwarf spheroidal galaxies to galaxy clusters. Our predictions are generally consistent with the data, with preference for the currently favored, flat low-density CDM model with cosmological constant (LambdaCDM). Such a comparison serves to test the basic CDM paradigm while constraining the background cosmology and the power spectrum of primordial density fluctuations, including larger wavenumbers than have previously been constrained.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/2002ApJ...565L...1S},
	Arxivurl = {http://arxiv.org/abs/astro-ph/0107442},
