	Eprint = {astro-ph/9708061},
	Journal = {MNRAS},
	Keywords = {Hipparcos Satellite, Stellar Magnitude, K Stars, Giant Stars, Metallic Stars, Calibrating, Astronomical Photometry, Stellar Parallax, Open Clusters, Galactic Structure, Milky Way Galaxy},
	Month = feb,
	Pages = {28},
	Title = {{HIPPARCOS absolute magnitudes for metal-rich K giants and the calibration of DDO photometry}},
	Volume = 294,
	Year = 1998,
	Bdsk-File-1 = {},
