	Doi = {10.1086/169577},
	Journal = {\apj},
	Keywords = {Carbon Monoxide, Galactic Structure, Interstellar Gas, Spiral Galaxies, Star Formation, Emission Spectra, H Ii Regions, Interplanetary Magnetic Fields, Radial Distribution, Star Distribution},
