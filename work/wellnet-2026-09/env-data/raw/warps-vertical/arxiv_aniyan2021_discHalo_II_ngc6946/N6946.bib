	Journal = {A\&A},
	Keywords = {GALAXIES: GENERAL, GALAXIES: KINEMATICS AND DYNAMICS, GALAXIES: LUMINOSITY FUNCTION, MASS FUNCTION, GALAXIES: SPIRAL},
	Month = dec,
	Pages = {517-525},
	Title = {{The maximum rotation of a galactic disc}},
	Volume = 328,
	Year = 1997,
	Bdsk-File-1 = {},
