@article{HF,
	Abstract = {Parallaxes for 581 bright K giants have been determined using the Hipparcos satellite. We combine the trigonometric parallaxes with ground-based photometric data to determine the K giant absolute magnitudes. For all these giants, absolute magnitude estimates can also be made using the intermediate-band photometric David Dunlop Observatory (DDO) system. We compare the DDO absolute magnitudes with the very accurate Hipparcos absolute magnitudes, finding various systematic offsets in the DDO system. These systematic effects can be corrected, and we provide a new calibration of the DDO system allowing absolute magnitude to be determined with an accuracy of 0.35 mag in the Mv range between 2 and -1. The new calibration performs well when tested on K giants with DDO photometry in a selection of low-reddening open clusters with well-measured distance moduli.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	Adsurl = {http://adsabs.harvard.edu/abs/1998MNRAS.294...28H},
	Arxivurl = {http://arXiv.org/abs/astro-ph/9708061},
