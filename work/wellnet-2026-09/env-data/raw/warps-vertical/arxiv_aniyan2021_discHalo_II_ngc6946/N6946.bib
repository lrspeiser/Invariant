	Keywords = {dark matter, galaxies: evolution, galaxies: formation, galaxies: fundamental parameters, galaxies: halos, galaxies: kinematics and dynamics, galaxies: spiral, galaxies: stellar content, galaxies: structure, methods: data analysis, techniques: spectroscopic},
	Month = jun,
	Pages = {234-268},
	Title = {{The DiskMass Survey. II. Error Budget}},
	Volume = 716,
	Year = 2010,
	Bdsk-File-1 = {},
	Bdsk-Url-1 = {http://dx.doi.org/10.1088/0004-637X/716/1/234},
