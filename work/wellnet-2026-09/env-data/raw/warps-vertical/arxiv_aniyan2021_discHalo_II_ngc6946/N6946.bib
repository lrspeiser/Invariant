	Doi = {10.1086/498713},
	Eprint = {astro-ph/0510374},
	Journal = {\aj},
	Keywords = {Galaxies: Clusters: General, Galaxies: Clusters: Individual: Name: Virgo, Galaxies: Formation, Galaxies: Fundamental Parameters, Galaxies: Spiral, Galaxies: Structure},
	Month = feb,
	Pages = {716-735},
	Title = {{A Comparison of H{$\alpha$} and Stellar Scale Lengths in Virgo and Field Spirals}},
