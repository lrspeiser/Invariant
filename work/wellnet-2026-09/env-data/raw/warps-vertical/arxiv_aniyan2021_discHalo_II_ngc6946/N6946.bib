@book{houk2,
	Abstract = {This is the fourth ofseven volumes in a program of systematic reclassification of the Henry Draper stars on the MK system and contains all HD stars between delta = -26$\,^{\circ}$.0 and -12$\,^{\circ}$.0. The stars were classified visually on objective-prism plates taken with the Michigan Curtis Schmidttelescope at Cerro Tololo Inter-American Observatory. The 4$\,^{\circ}$+6$\,^{\circ}$ prisms yield a dispersion at Hgamma of 108 {\AA}/mm, and the resolution is about 2 {\AA}/mm, comparable to that of the original MK system. The spectra were taken on IIaO plates and widened to 0.8 mm, with 20m, 4m, and 1m exposures being obtained. Of the 33,301 stars in the catalogue, 32,563 or 98% were classifiable. Previously published types are listed for the 2% not classifiable on the plates. Internal classification errors were obtained using the stars classified independently on more than one plate. Both the internal and external errors are similar to those usually obtained in the classification of slit spectra.},
	Adsnote = {Provided by the SAO/NASA Astrophysics Data System},
