	Doi = {10.1086/317148},
	Eprint = {astro-ph/0006275},
	Journal = {\apj},
	Keywords = {Galaxies: Evolution, Galaxies: Halos, Galaxies: Kinematics and Dynamics, Galaxy: Halo, Galaxy: Structure},
	Month = nov,
	Pages = {704-721},
	Title = {{Constraints from Dynamical Friction on the Dark Matter Content of Barred Galaxies}},
	Volume = 543,
	Year = 2000,
	Bdsk-File-1 = {},
