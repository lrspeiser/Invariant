</FIELD>
<FIELD arraysize="*" datatype="char" name="GALREERR_r" ucd="phys.angSize;stat.error;meta.modelled;em.opt.r" unit="arcsec">
<DESCRIPTION>GALFIT error on re</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="GALINDEXERR_r" ucd="stat.fit.param;stat.error;meta.modelled;em.opt.r">
