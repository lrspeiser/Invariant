<FIELD arraysize="*" datatype="char" name="CUBEID" ucd="meta.id">
<DESCRIPTION>Internal unique cube ID</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="CUBENAME" ucd="meta.id">
<DESCRIPTION>Internal unique cube name for blue cube</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="CATID" ucd="meta.id">
<DESCRIPTION>SAMI Galaxy ID</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="CUBEFWHM" ucd="inst.beam" unit="arcsec">
<DESCRIPTION>FWHM of PSF in cube</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="CUBETEXP" ucd="obs.exposure" unit="sec">
<DESCRIPTION>Total exposure time for cube</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="MEANTRANS" ucd="obs.param">
<DESCRIPTION>Mean transmission for cube</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="ISBEST" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate best repeat</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="CATSOURCE" ucd="meta.code.class">
<DESCRIPTION>Flag to identify input source catalogue</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSTAR" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate that object is a calibration star</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNFILL" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate that object is from a filler catalogue</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNZ" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate potential error in input catalogue redshift</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNMULT" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate multiple objects within IFU field-of-view</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNAKPC" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate 3kpc aperture spectra are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNARE" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate Sersic Re aperture spectra are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNAMGE" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate MGE Re aperture spectra are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSK2M" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate 2-moment stellar kinematics are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSK4M" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate 4-moment stellar kinematics are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSK4MHSN" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate high-S/N binned 4-moment stellar kinematics are missing</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNFCAL" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate flux calibration issues</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNFCBR" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate flux calibration issues with offset between red and blue arm</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSKYB" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate excess sky subtraction residuals in blue arm</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSKYR" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate excess sky subtraction residuals in red arm</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSKER" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate problem with stellar kinematics</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNWCS" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate target galaxy is offset from centre of cube</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNRE" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate large difference between MGE and Sersic effective radius</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNSKEM" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate possible impact of sky lines on emission line fitting</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="WARNEMFT" ucd="meta.code.qual">
<DESCRIPTION>Flag to indicate missing emission line fits</DESCRIPTION>
</FIELD>
