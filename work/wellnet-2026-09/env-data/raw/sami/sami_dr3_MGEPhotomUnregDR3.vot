<TABLE name="result_S1788496127838">
<FIELD arraysize="*" datatype="char" name="CATID" ucd="meta.id">
<DESCRIPTION>SAMI Galaxy ID. Galaxies with two entries have both VST and SDSS photometry.</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="photometry" ucd="meta.ref">
<DESCRIPTION>Denotes which images were used.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="ReMGE" ucd="phys.angSize" unit="arcsec">
<DESCRIPTION>Circularised effective radius from MGE fit.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="mMGE" ucd="phot.mag" unit="mag">
<DESCRIPTION>Total AB magnitude from the MGE fit. No corrections applied.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="rExtinction" ucd="phys.absorption" unit="mag">
<DESCRIPTION>Extinction from Schlafly+2011.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="PAMGE" ucd="pos.posAng" unit="deg">
<DESCRIPTION>Position Angle of the MGE model, from N to E is positive.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="epsMGE_Re" ucd="src.ellipticity">
<DESCRIPTION>Model isophotal ellipticity at  one Re.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="epsMGE_LW" ucd="src.ellipticity">
<DESCRIPTION>Light-weighted ellipticity of the model.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="dist2NNeigh" ucd="pos.angDistance" unit="arcsec">
<DESCRIPTION>Distance to nearest neighbour from SExtractor source extraction.</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="Chi2" ucd="stat.fit.chi2">
<DESCRIPTION>Chi^2 from MGE fit.</DESCRIPTION>
</FIELD>
