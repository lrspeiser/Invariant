<TABLE name="result_S1788496131308">
<FIELD arraysize="*" datatype="char" name="CUBEID" ucd="meta.id">
<DESCRIPTION>Internal ID for cube</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="CUBEIDPUB" ucd="meta.id">
<DESCRIPTION>Public cube ID</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="CUBENAME" ucd="meta.id">
<DESCRIPTION>Name of blue cube file</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="CATID" ucd="meta.id">
<DESCRIPTION>Catalog ID from Bryant et al. 2015 and Owers et al. 2017</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="PA_STELKIN" ucd="pos.posAng" unit="deg">
<DESCRIPTION>Kinematic position angle. Anticlockwise, North=0 degrees</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="PA_STELKIN_ERR" ucd="pos.posAng" unit="deg">
<DESCRIPTION>1-sigma error on the kinematic position angle</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_RE" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from Re Sersic aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_RE_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_re</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_3KPC_ROUND" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from 3kpc aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_3KPC_ROUND_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_3kpc</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_1_4_ARCSECOND" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from 1.4 arcsec aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_1_4_ARCSECOND_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_1_4_arcsec</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_2_ARCSECOND" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from 2 arcsec aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_2_ARCSECOND_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_2_arcsec</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_3_ARCSECOND" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from 3 arcsec aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_3_ARCSECOND_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_3_arcsec</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_4_ARCSECOND" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from 4 arcsec aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_4_ARCSECOND_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_4_arcsec</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="APER_CORR_FLAG" ucd="meta.code.error">
<DESCRIPTION>Flag to indicate whether lambdar_re and vsigma_re have been aperture corrected. 0 = no aperture correction applied. 1 = inside-out aperture corrected (rmax &lt; re). 2 = from outside in (re &lt; hwhm_psf)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="RMAX_APER_CORR" ucd="arith.ratio" unit="Re">
<DESCRIPTION>Radius at which the aperture corrected value was determined from</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_RE" ucd="arith.ratio">
<DESCRIPTION>Spin Parameter proxy within effective ellipse as defined in van de Sande et al. 2017</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_RE_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on lambdar_re</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_MAX" ucd="arith.ratio">
<DESCRIPTION>Lambdar at maximum radius that is used for aperture correction (where APER_CORR_FLAG = 1)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_MAX_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on lambdar_Max</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="VSIGMA_RE" ucd="arith.ratio">
<DESCRIPTION>Flux weighted V/sigma within Re effective ellipse</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="VSIGMA_RE_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on vsigma_e</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="VSIGMA_MAX" ucd="arith.ratio">
<DESCRIPTION>V/sigma at maximum radius that is used for aperture correction (where APER_CORR_FLAG = 1)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="VSIGMA_MAX_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on VSigma_max</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="MEAN_K51_RE" ucd="arith.ratio">
<DESCRIPTION>kinematic asymmetry estimate from kinemetry within Re</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="MEAN_K51_RE_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on mean_k51_re</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_RE_MGE" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>Velocity dispersion from MGE Re aperture spectra</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="SIGMA_RE_MGE_ERR" ucd="phys.veloc.dispersion" unit="km/s">
<DESCRIPTION>1-sigma error on sigma_re_mge</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="APER_CORR_FLAG_MGE" ucd="meta.code.error">
<DESCRIPTION>Flag to indicate whether lambdar_re_mge and vsigma_re_mge have been aperture corrected. 0 = no aperture correction applied. 1 = inside-out aperture corrected (rmax &lt; MGE re). 2 = from outside in (re &lt; hwhm_psf)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="RMAX_APER_CORR_MGE" ucd="arith.ratio" unit="Re">
<DESCRIPTION>MGE relative Radius at which the aperture corrected value was determined from</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_RE_MGE" ucd="arith.ratio">
<DESCRIPTION>Spin Parameter proxy within MGE effective ellipse as defined in van de Sande et al. 2017</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_RE_MGE_ERR" ucd="arith.ratio">
<DESCRIPTION>1-sigma error on lambdar_re_mge</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="LAMBDAR_MAX_MGE" ucd="arith.ratio">
<DESCRIPTION>MGE Lambdar at maximum radius that is used for aperture correction (where APER_CORR_FLAG_MGE = 1)</DESCRIPTION>
</FIELD>
