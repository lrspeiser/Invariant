% remember original state
/origstate save def

% build a temporary dictionary
20 dict begin

% define string to hold a scanline's worth of data
/pix 927 string def

% define space for color conversions
/grays 927 string def  % space for gray scale line
/npixls 0 def
/rgbindx 0 def

% lower left corner
186 313 translate

% size of image (on paper, in 1/72inch coords)
222.48000 216.00000 scale

927 900 8			% dimensions of data
[927 0 0 -900 0 900]		% mapping matrix
{currentfile pix readhexstring pop}
