% remember original state
/origstate save def

% build a temporary dictionary
20 dict begin

% define space for color conversions
/grays 939 string def  % space for gray scale line
/npixls 0 def
/rgbindx 0 def

% lower left corner
35 233 translate

% size of image (on paper, in 1/72inch coords)
539.92800 378.93600 scale

% define the colormap
/cmap 256 string def


% load up the colormap
currentfile cmap readhexstring
