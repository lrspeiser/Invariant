% remember original state
/origstate save def

% build a temporary dictionary
20 dict begin

% define space for color conversions
/grays 935 string def  % space for gray scale line
/npixls 0 def
/rgbindx 0 def

% lower left corner
35 214 translate

% size of image (on paper, in 1/72inch coords)
537.62400 398.44800 scale

% define the colormap
/cmap 256 string def


% load up the colormap
currentfile cmap readhexstring
