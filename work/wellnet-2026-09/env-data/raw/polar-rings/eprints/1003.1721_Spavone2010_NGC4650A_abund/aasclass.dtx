% \begin{macro}{\author}
% \begin{macro}{\authoraddr}
% \begin{macro}{\email}
% \begin{macro}{\affil}
% \begin{macro}{\altaffilmark}
% \begin{macro}{\altaffiltext}
% \begin{macro}{\and}
% The title block commands simply queue up the 
% given tokens into the appropriate control sequence.
